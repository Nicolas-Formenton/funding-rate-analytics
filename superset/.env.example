# ---- Superset admin bootstrap (read by the superset-init container) ----
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_FIRSTNAME=Admin
SUPERSET_ADMIN_LASTNAME=User
SUPERSET_ADMIN_EMAIL=admin@funding-rate-analytics.local
SUPERSET_ADMIN_PASSWORD=changeme-admin-password

# ---- Superset session signing ----
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SUPERSET_SECRET_KEY=replace-me-with-a-real-64-byte-token

# ---- Supabase (target database) ----
# Only the password is secret. Host/port/user/schema are intentionally
# defaulted in superset_config.py so they stay out of .env.
SUPABASE_DB_HOST=db.djtnqbvkhqftmtnsityx.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_SCHEMA=marts
SUPABASE_DB_PASSWORD=replace-with-the-real-supabase-db-password
