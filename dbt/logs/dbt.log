    AVG(premium_bps) AS avg_premium_bps,
    AVG(mark_price) AS avg_mark_price,
    AVG(index_price) AS avg_index_price
FROM "postgres"."staging_staging"."stg_funding_events"
WHERE funding_rate_annualized_pct IS NOT NULL
GROUP BY 1, 2, 3, 4
  );
  
